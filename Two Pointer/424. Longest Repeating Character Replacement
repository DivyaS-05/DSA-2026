You are given a string s and an integer k. You can choose any character of the string and change it to any other uppercase English character. You can perform this operation at most k times.
Return the length of the longest substring containing the same letter you can get after performing the above operations.
Example 1:
Input: s = "ABAB", k = 2
Output: 4
Explanation: Replace the two 'A's with two 'B's or vice versa.

Example 2:
Input: s = "AABABBA", k = 1
Output: 4
Explanation: Replace the one 'A' in the middle with 'B' and form "AABBBBA".
The substring "BBBB" has the longest repeating letters, which is 4.
There may exists other ways to achieve this answer too.

method -1 using map tc=O(n*M) SCO(m) m-26
class Solution {
    public int characterReplacement(String s, int k) {
        HashMap<Character, Integer> map = new HashMap<>();
        map.put(s.charAt(0), 1);
        int j = 0;
        int i = 0;
        int maxCount = 0;
        while (j < s.length()) {
            if (isValidWindow(map, k)) {
                maxCount = Math.max(maxCount, j - i + 1);
                j++;
                if(j>=s.length()){
                    break;
                }
                if ( !map.containsKey(s.charAt(j))) {
                    map.put(s.charAt(j), 1);
                }else{
                    map.put(s.charAt(j),map.get(s.charAt(j))+1);
                }
            }else{
                map.put(s.charAt(i),map.get(s.charAt(i))-1);
                i++;
            }
        }
        return maxCount;
     }

    public boolean isValidWindow(HashMap<Character, Integer> map, int k) {
        int Totalcount = 0;
        int MaxCount = 0;
        for (int i : map.values()) {
            Totalcount += i;
            MaxCount = Math.max(MaxCount, i);
        }
        return (Totalcount-MaxCount<=k)? true :false;
    }
}

Method -2 using array
class Solution {
    public int characterReplacement(String s, int k) {
        int[] map = new int[26];
        map[s.charAt(0) - 65] = 1;
        int j = 0;
        int i = 0;
        int maxCount = 0;
        while (j < s.length()) {
            if (isValidWindow(map, k)) {
                maxCount = Math.max(maxCount, j - i + 1);
                j++;
                if (j >= s.length()) {
                    break;
                }
                map[s.charAt(j) - 65]++;
            } else {
                map[s.charAt(i) - 65]--;
                i++;
            }
        }
        return maxCount;
    }

    public boolean isValidWindow(int[] map, int k) {
        int Totalcount = 0;
        int MaxCount = 0;
        for (int i = 0; i < map.length; i++) {
            Totalcount += map[i];
            MaxCount = Math.max(MaxCount, map[i]);
        }
        return (Totalcount - MaxCount <= k) ? true : false;
    }
}
